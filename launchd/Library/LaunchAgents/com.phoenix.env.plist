<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Gives apps opened from the Dock or Spotlight the variables of ~/.zshenv; see ~/.config/launchd/setenv.zsh. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.phoenix.env</string>
  <key>ProgramArguments</key><array><string>/bin/zsh</string><string>-c</string><string>exec /bin/zsh "$HOME/.config/launchd/setenv.zsh"</string></array>
  <key>RunAtLoad</key><true/>
  <!-- launchd expands no ~ or $HOME here, so the real file behind ~/.zshenv is spelled out. -->
  <key>WatchPaths</key><array><string>/Users/fau/Documents/Fau/dotfiles/zsh/.zshenv</string></array>
  <key>StandardOutPath</key><string>/Users/fau/Library/Logs/com.phoenix.env.log</string>
  <key>StandardErrorPath</key><string>/Users/fau/Library/Logs/com.phoenix.env.log</string>
</dict>
</plist>
